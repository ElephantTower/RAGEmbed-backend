model Message {
  id String @id @default(cuid())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  role       Role
  content    String
  rawContent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  system
  assistant
  user
}
